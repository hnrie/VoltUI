{
  "name": "voltui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Volt desktop client recovered as a Vite app with a Node.js backend.",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "start": "tsx server/main.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "cors": "2.8.5",
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vite": "6.0.7"
  }
}
